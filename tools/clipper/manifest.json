{
  "manifest_version": 3,
  "name": "Budget Basket Clipper",
  "version": "1.0.0",
  "description": "Saves the product names, prices and sales on store pages YOU open, so Budget Basket can compare them. It never loads or clicks anything by itself.",
  "permissions": ["storage", "unlimitedStorage", "downloads"],
  "action": { "default_popup": "popup.html", "default_title": "Budget Basket Clipper",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.walmart.ca/*", "https://www.realcanadiansuperstore.ca/*", "https://www.wholesaleclub.ca/*"],
      "js": ["hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.walmart.ca/*", "https://www.realcanadiansuperstore.ca/*", "https://www.wholesaleclub.ca/*"],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
